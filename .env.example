# Funding Finder — environment template
# Copy to `.env` (repo root) for docker-compose, or `backend/.env` for bare-node runs.
# PRODUCTION SECURITY: the JWT/WEBHOOK/ENCRYPTION secrets below are placeholders.
# The backend REJECTS these known-weak values in production (fail-closed).
# Generate real ones with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the real `.env`.

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/funding_finder"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/funding_finder"
# docker-compose only: password for the bundled PostgreSQL
POSTGRES_PASSWORD=postgres

# Server
PORT=3000
# production | development | test. Unset NODE_ENV is treated as production (fail-closed).
NODE_ENV=production

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=fundinganalyzerbot
ADMIN_TELEGRAM_IDS=

# Secrets — REQUIRED in production, min 32 chars each.
# JWT (for API authentication)
JWT_SECRET=change-me-to-random-64-chars
# Webhook signing secret (Crypto Pay / generic webhook)
WEBHOOK_SECRET=change-me-to-random-64-chars
# Encryption key for stored exchange API keys (AES-256-GCM)
ENCRYPTION_KEY=change-me-to-random-32-chars-min

# AI
OPENROUTER_API_KEY=your_openrouter_key_here
AI_MODEL=x-ai/grok-4.1-fast:free
AI_MODELS=
AI_APP_URL=https://funding-finder-frontend.onrender.com
AI_APP_TITLE=Funding Finder

# Exchange defaults
SETTLE=usdt
MIN_FUNDING_ABS=0.0005
MIN_VOLUME_24H=1000

# Crypto Pay (Telegram MiniApp payments)
CRYPTO_PAY_API_TOKEN=your_crypto_pay_token_here
CRYPTO_BOT_USERNAME=CryptoBot
# mainnet | testnet — switch to mainnet to accept real payments
CRYPTO_PAY_NETWORK=mainnet

# NOWPayments (crypto payments for the public website)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key_here
# IPN (Instant Payment Notification) secret — HMAC-SHA512 webhook signature check
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret_here
# live | sandbox — switch to live to accept real payments
NOWPAYMENTS_NETWORK=live

# Public base URL of THIS API service (used for IPN callback URLs and keep-alive)
API_BASE_URL=https://funding-finder-api.onrender.com

# Google OAuth (website login via Google, optional)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Web Auth — SIWE message domain (must match the website domain)
WEB_AUTH_DOMAIN=funding-finder-frontend.onrender.com

# CORS (comma-separated origins)
CORS_ORIGINS=https://t.me,https://telegram.org,https://funding-finder-frontend.onrender.com

# Prometheus metrics: '1' = public scrape, '0' = admin-only (recommended)
PROMETHEUS_PUBLIC=0

# Optional: Redis (single-instance in-memory fallback when empty)
REDIS_URL=

# Optional: push notifications / email / sentry
PUSHOVER_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Funding Finder <noreply@fundingfinder.app>
SENTRY_DSN=

# Optional: marketing signal channel (chat_id or @channel)
PUBLIC_SIGNAL_CHANNEL=
